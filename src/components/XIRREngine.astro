---
// Irregular Cash Flow XIRR Engine Interactive Component
---

<div class="calculator-card" id="xirr-engine">
  <div class="calc-header">
    <div class="badge-row">
      <span class="badge badge-gold">Quantitative Engine</span>
      <span class="badge badge-green">Newton-Raphson Solver</span>
    </div>
    <h3>XIRR Engine: Irregular Cash Flow Rate of Return</h3>
    <p class="calc-subtitle">
      Solves the exact annualized internal rate of return for non-periodic investments, SIP top-ups, partial redemptions, and dividend flows.
    </p>
  </div>

  <div class="table-container">
    <table id="xirr-table" class="cash-flow-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Transaction Date</th>
          <th>Cash Flow Amount (₹)</th>
          <th>Type / Direction</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody id="cash-flow-tbody">
        <!-- Dynamically managed via script -->
      </tbody>
    </table>
  </div>

  <div class="controls-bar">
    <button type="button" id="btn-add-row" class="btn">＋ Add Cash Flow</button>
    <button type="button" id="btn-load-sample" class="btn">Load 3-Year SIP Sample</button>
    <button type="button" id="btn-clear-flows" class="btn">Clear Rows</button>
    <button type="button" id="btn-calc-xirr" class="btn btn-gold">Solve Annualized XIRR</button>
  </div>

  <div id="xirr-results" class="results-panel" aria-live="polite">
    <div class="results-grid">
      <div class="result-tile highlight-tile">
        <span class="tile-label">Annualized XIRR</span>
        <span class="tile-value value-primary" id="res-xirr-val">--</span>
        <span class="tile-subtext">True money-weighted annualized return</span>
      </div>

      <div class="result-tile">
        <span class="tile-label">Total Outflows (Invested)</span>
        <span class="tile-value" id="res-total-invested">₹0</span>
        <span class="tile-subtext">Cumulative capital committed</span>
      </div>

      <div class="result-tile">
        <span class="tile-label">Current / Terminal Value</span>
        <span class="tile-value" id="res-current-val">₹0</span>
        <span class="tile-subtext">Portfolio valuation or redemptions</span>
      </div>

      <div class="result-tile">
        <span class="tile-label">Absolute Return / Net Gain</span>
        <span class="tile-value" id="res-net-gain">₹0</span>
        <span class="tile-subtext" id="res-abs-gain-pct">--</span>
      </div>
    </div>

    <div class="callout callout-warning">
      <h5>Methodology: Newton-Raphson vs Simple CAGR</h5>
      <p>
        While <strong>CAGR</strong> only evaluates two points in time (V_end / V_start)^(1/t) - 1, Indian mutual fund investors deposit money on varied SIP dates, step-ups, and bonus allocations. 
        <strong>XIRR</strong> solves the polynomial sum [ C_t / (1 + r)^((d_t - d_0)/365) ] = 0. All dates are exact calendar day counts.
      </p>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    let flows = [
      { date: '2022-01-10', amount: -50000, desc: 'Initial Lumpsum' },
      { date: '2022-07-15', amount: -25000, desc: 'Top-up Investment' },
      { date: '2023-02-20', amount: -25000, desc: 'Bonus Investment' },
      { date: '2023-11-05', amount: -50000, desc: 'Festival Allocation' },
      { date: '2024-10-15', amount: 205000, desc: 'Current Portfolio Value' },
    ];

    const tbody = document.getElementById('cash-flow-tbody');
    const addRowBtn = document.getElementById('btn-add-row');
    const sampleBtn = document.getElementById('btn-load-sample');
    const clearBtn = document.getElementById('btn-clear-flows');
    const calcBtn = document.getElementById('btn-calc-xirr');

    if (!tbody || !addRowBtn || !calcBtn) return;

    function renderTable() {
      tbody.innerHTML = '';
      flows.forEach((item, index) => {
        const tr = document.createElement('tr');
        const isLast = index === flows.length - 1;
        const isNegative = item.amount < 0;

        tr.innerHTML = `
          <td>${index + 1}</td>
          <td>
            <input type="date" class="form-control form-control-sm flow-date" value="${item.date}" data-idx="${index}" />
          </td>
          <td>
            <input type="number" class="form-control form-control-sm flow-amount" value="${Math.abs(item.amount)}" data-idx="${index}" step="100" />
          </td>
          <td>
            <select class="form-control form-control-sm flow-type" data-idx="${index}">
              <option value="outflow" ${isNegative ? 'selected' : ''}>Outflow / Investment (-)</option>
              <option value="inflow" ${!isNegative ? 'selected' : ''}>Inflow / Redemption (+)</option>
            </select>
          </td>
          <td>
            <button type="button" class="btn-delete" data-idx="${index}" aria-label="Delete cash flow">✕</button>
          </td>
        `;
        tbody.appendChild(tr);
      });

      attachRowListeners();
    }

    function attachRowListeners() {
      tbody.querySelectorAll('.flow-date').forEach(input => {
        input.addEventListener('change', (e) => {
          const idx = parseInt(e.target.dataset.idx);
          flows[idx].date = e.target.value;
          solveAndDisplay();
        });
      });

      tbody.querySelectorAll('.flow-amount').forEach(input => {
        input.addEventListener('input', (e) => {
          const idx = parseInt(e.target.dataset.idx);
          const val = Math.abs(parseFloat(e.target.value) || 0);
          const typeSelect = tbody.querySelector(`.flow-type[data-idx="${idx}"]`);
          const sign = typeSelect.value === 'outflow' ? -1 : 1;
          flows[idx].amount = sign * val;
          solveAndDisplay();
        });
      });

      tbody.querySelectorAll('.flow-type').forEach(select => {
        select.addEventListener('change', (e) => {
          const idx = parseInt(e.target.dataset.idx);
          const amountInput = tbody.querySelector(`.flow-amount[data-idx="${idx}"]`);
          const val = Math.abs(parseFloat(amountInput.value) || 0);
          const sign = e.target.value === 'outflow' ? -1 : 1;
          flows[idx].amount = sign * val;
          solveAndDisplay();
        });
      });

      tbody.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const idx = parseInt(e.target.dataset.idx);
          if (flows.length <= 2) {
            alert('A minimum of 2 cash flows is required for XIRR calculation.');
            return;
          }
          flows.splice(idx, 1);
          renderTable();
          solveAndDisplay();
        });
      });
    }

    addRowBtn.addEventListener('click', () => {
      const today = new Date().toISOString().split('T')[0];
      flows.push({ date: today, amount: -10000, desc: 'New Cash Flow' });
      renderTable();
      solveAndDisplay();
    });

    sampleBtn.addEventListener('click', () => {
      flows = [
        { date: '2022-01-10', amount: -50000 },
        { date: '2022-07-15', amount: -25000 },
        { date: '2023-02-20', amount: -25000 },
        { date: '2023-11-05', amount: -50000 },
        { date: '2024-10-15', amount: 205000 },
      ];
      renderTable();
      solveAndDisplay();
    });

    clearBtn.addEventListener('click', () => {
      flows = [
        { date: '2023-01-01', amount: -100000 },
        { date: '2024-01-01', amount: 115000 },
      ];
      renderTable();
      solveAndDisplay();
    });

    calcBtn.addEventListener('click', solveAndDisplay);

    function calculateXIRRNewton(cashFlowList) {
      if (!cashFlowList || cashFlowList.length < 2) return null;

      const sorted = [...cashFlowList].map(cf => ({
        date: new Date(cf.date),
        amount: Number(cf.amount)
      })).sort((a, b) => a.date.getTime() - b.date.getTime());

      let hasNeg = false;
      let hasPos = false;
      for (const cf of sorted) {
        if (cf.amount < 0) hasNeg = true;
        if (cf.amount > 0) hasPos = true;
      }
      if (!hasNeg || !hasPos) return null;

      const d0 = sorted[0].date.getTime();
      const MS_PER_DAY = 1000 * 60 * 60 * 24;
      const yearsArr = sorted.map(cf => (cf.date.getTime() - d0) / (MS_PER_DAY * 365.0));

      let r = 0.1;
      const maxIter = 100;
      const tol = 1e-6;

      for (let i = 0; i < maxIter; i++) {
        if (r <= -0.999) r = -0.999;
        let f = 0;
        let df = 0;

        for (let j = 0; j < sorted.length; j++) {
          const t = yearsArr[j];
          const amt = sorted[j].amount;
          const denom = Math.pow(1 + r, t);
          f += amt / denom;
          df -= (t * amt) / (denom * (1 + r));
        }

        if (Math.abs(f) < tol) return r;
        if (Math.abs(df) < 1e-12) {
          r += 0.01;
          continue;
        }

        const nextR = r - f / df;
        if (Math.abs(nextR - r) < tol) return nextR;
        r = nextR;
      }
      return r;
    }

    function solveAndDisplay() {
      let totalInvested = 0;
      let totalInflows = 0;

      flows.forEach(f => {
        if (f.amount < 0) totalInvested += Math.abs(f.amount);
        else totalInflows += f.amount;
      });

      const netGain = totalInflows - totalInvested;
      const absGainPct = totalInvested > 0 ? (netGain / totalInvested) * 100 : 0;

      const xirr = calculateXIRRNewton(flows);

      const xirrValEl = document.getElementById('res-xirr-val');
      const investedEl = document.getElementById('res-total-invested');
      const currValEl = document.getElementById('res-current-val');
      const netGainEl = document.getElementById('res-net-gain');
      const absGainPctEl = document.getElementById('res-abs-gain-pct');

      if (investedEl) investedEl.textContent = '₹' + totalInvested.toLocaleString('en-IN');
      if (currValEl) currValEl.textContent = '₹' + totalInflows.toLocaleString('en-IN');

      if (netGainEl) {
        netGainEl.textContent = (netGain >= 0 ? '+₹' : '-₹') + Math.abs(netGain).toLocaleString('en-IN');
        netGainEl.className = 'tile-value ' + (netGain >= 0 ? 'value-positive' : 'value-negative');
      }

      if (absGainPctEl) {
        absGainPctEl.textContent = `Absolute return: ${absGainPct >= 0 ? '+' : ''}${absGainPct.toFixed(2)}%`;
      }

      if (xirrValEl) {
        if (xirr === null || isNaN(xirr)) {
          xirrValEl.textContent = 'Invalid Cash Flows';
          xirrValEl.className = 'tile-value value-negative';
        } else {
          xirrValEl.textContent = (xirr * 100).toFixed(2) + '%';
          xirrValEl.className = 'tile-value ' + (xirr >= 0 ? 'value-primary' : 'value-negative');
        }
      }
    }

    // Initial render
    renderTable();
    solveAndDisplay();
  })();
</script>

<style>
  .calculator-card {
    background-color: var(--iq-surface);
    border: 1px solid var(--iq-border);
    border-radius: var(--iq-radius-lg);
    padding: 2rem;
    box-shadow: var(--iq-shadow-md);
    margin: 2rem 0;
  }

  .calc-header {
    margin-bottom: 1.5rem;
  }

  .badge-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .calc-subtitle {
    color: var(--iq-text-secondary);
    font-size: 0.95rem;
    margin-top: 0.25rem;
  }

  .table-container {
    overflow-x: auto;
    border: 1px solid var(--iq-border);
    border-radius: var(--iq-radius-md);
    margin-bottom: 1.25rem;
  }

  .cash-flow-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .cash-flow-table th,
  .cash-flow-table td {
    padding: 0.6rem 0.8rem;
    border-bottom: 1px solid var(--iq-border);
  }

  .cash-flow-table th {
    background-color: var(--iq-surface-raised);
    color: var(--iq-text-secondary);
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .form-control-sm {
    padding: 0.35rem 0.5rem;
    font-size: 0.85rem;
  }

  .btn-delete {
    background: transparent;
    border: none;
    color: var(--iq-danger);
    font-weight: bold;
    cursor: pointer;
    font-size: 1rem;
    padding: 0.2rem 0.5rem;
  }

  .controls-bar {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .results-panel {
    background-color: var(--iq-surface-raised);
    border: 1px solid var(--iq-border);
    border-radius: var(--iq-radius-md);
    padding: 1.5rem;
  }

  .results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .result-tile {
    background-color: var(--iq-surface);
    border: 1px solid var(--iq-border-subtle);
    border-radius: var(--iq-radius-md);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .highlight-tile {
    border-color: var(--iq-rupee-gold);
    background: linear-gradient(180deg, var(--iq-surface) 0%, var(--iq-rupee-gold-glow) 100%);
  }

  .tile-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--iq-text-secondary);
    margin-bottom: 0.5rem;
  }

  .tile-value {
    font-size: 1.75rem;
    font-weight: 800;
    font-family: var(--iq-font-mono);
  }

  .value-primary {
    color: var(--iq-rupee-gold);
  }

  .value-positive {
    color: var(--iq-success);
  }

  .value-negative {
    color: var(--iq-danger);
  }

  .tile-subtext {
    font-size: 0.75rem;
    color: var(--iq-text-muted);
    margin-top: 0.35rem;
  }
</style>
