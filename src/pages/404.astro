---
import BaseLayout from '../layouts/BaseLayout.astro';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout 
  title="Page Not Found (404)"
  description="The requested financial mathematical paper or solver route was not found on InvestiQ RupeeMath."
>
  <div class="container container-narrow error-page-content">
    <div class="error-badge">404</div>
    <h1>Quantum Null: Equation Route Not Found</h1>
    <p class="error-desc">
      The mathematical paper, calculator endpoint, or resource you requested does not exist or may have been reorganized within our research index.
    </p>

    <div class="suggested-links card">
      <h3>Recommended Destinations</h3>
      <ul>
        <li><a href={`${basePath}/`}>RupeeMath Homepage & Featured Solvers</a></li>
        <li><a href={`${basePath}/articles/`}>Quantitative Research Library (15+ Papers)</a></li>
        <li><a href={`${basePath}/calculators/`}>Interactive Financial Calculators</a></li>
        <li><a href={`${basePath}/glossary/`}>Financial Mathematics Glossary</a></li>
      </ul>
    </div>

    <div style="margin-top: 2rem;">
      <a href={`${basePath}/`} class="btn btn-gold">Return to Home</a>
    </div>
  </div>
</BaseLayout>

<style>
  .error-page-content {
    padding-top: 4rem;
    padding-bottom: 4rem;
    text-align: center;
  }
  .error-badge {
    font-size: 5rem;
    font-weight: 900;
    font-family: var(--iq-font-mono);
    color: var(--iq-rupee-gold);
    line-height: 1;
    margin-bottom: 1rem;
  }
  .error-desc {
    font-size: 1.15rem;
    color: var(--iq-text-secondary);
    max-width: 600px;
    margin: 0 auto 2rem;
  }
  .suggested-links {
    text-align: left;
    max-width: 500px;
    margin: 0 auto;
  }
  .suggested-links h3 {
    margin-top: 0;
    margin-bottom: 0.75rem;
    font-size: 1.1rem;
  }
  .suggested-links ul {
    margin-bottom: 0;
  }
  .suggested-links li {
    margin-bottom: 0.5rem;
  }
</style>
