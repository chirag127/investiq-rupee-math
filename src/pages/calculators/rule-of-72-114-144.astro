---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RuleMultiplierVisualizer from '../../components/RuleMultiplierVisualizer.astro';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout 
  title="Rule of 72, 114 & 144 Visualizer"
  description="Explore compounding multiplier heuristics versus exact logarithmic calculations for asset doubling, tripling, quadrupling, and purchasing-power halving."
>
  <div class="container container-narrow page-header">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`${basePath}/`}>Home</a> &gt; 
      <a href={`${basePath}/calculators/`}>Calculators</a> &gt; 
      <span>Compounding Multiplier Visualizer</span>
    </nav>
    <h1>Compounding Multiplier Visualizer</h1>
    <p class="page-subtitle">
      Inspect exponential asset acceleration curves: Doubling (72), Tripling (114), and Quadrupling (144) horizons vs exact logarithmic calculation ln(M) / ln(1+r).
    </p>
  </div>

  <div class="container container-narrow">
    <RuleMultiplierVisualizer />
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-top: 2rem;
    padding-bottom: 1.5rem;
  }
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--iq-text-muted);
    margin-bottom: 1rem;
  }
  .breadcrumb a {
    color: var(--iq-text-secondary);
  }
  .page-subtitle {
    color: var(--iq-text-secondary);
    font-size: 1.1rem;
    margin-top: 0.5rem;
  }
</style>
