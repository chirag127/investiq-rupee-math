---
import BaseLayout from '../../layouts/BaseLayout.astro';
import XIRREngine from '../../components/XIRREngine.astro';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout 
  title="XIRR Engine: Irregular Cash Flow Rate of Return"
  description="Newton-Raphson numerical solver for calculating the exact annualized internal rate of return for irregular Indian SIPs, top-ups, and redemptions."
>
  <div class="container container-narrow page-header">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`${basePath}/`}>Home</a> &gt; 
      <a href={`${basePath}/calculators/`}>Calculators</a> &gt; 
      <span>XIRR Engine</span>
    </nav>
    <h1>XIRR Engine: Irregular Cash Flow Solver</h1>
    <p class="page-subtitle">
      Solves the polynomial sum [ C_t / (1 + r)^((d_t - d_0)/365) ] = 0 for non-periodic investments and withdrawals.
    </p>
  </div>

  <div class="container container-narrow">
    <XIRREngine />
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-top: 2rem;
    padding-bottom: 1.5rem;
  }
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--iq-text-muted);
    margin-bottom: 1rem;
  }
  .breadcrumb a {
    color: var(--iq-text-secondary);
  }
  .page-subtitle {
    color: var(--iq-text-secondary);
    font-size: 1.1rem;
    margin-top: 0.5rem;
  }
</style>
